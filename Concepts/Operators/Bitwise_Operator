// Bitwise Operator


public class Bitwise {
    public static void main(String[] args) {
        int a = 5, b = 3;

        System.out.println("AND: " + (a & b));
        System.out.println("OR: " + (a | b));
        System.out.println("XOR: " + (a ^ b));
        System.out.println("NOT: " + (~a));
    }
}


/*
AND: 1
OR: 7
XOR: 6
NOT: -6
*/